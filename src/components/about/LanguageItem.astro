---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'languages'>;
}

const { item } = Astro.props;
const { name, nameEn, proficiency, proficiencyEn, note, noteEn } = item.data;
const noteEnResolved = noteEn ?? note;
---

<div class="lang-card">
  <p class="lang-proficiency">
    <span data-lang="ko">{proficiency}</span><span data-lang="en"
      >{proficiencyEn ?? proficiency}</span
    >
  </p>
  <h3 class="lang-name">
    <span data-lang="ko">{name}</span><span data-lang="en">{nameEn ?? name}</span>
  </h3>
  {
    (note || noteEnResolved) && (
      <>
        {note && <p class="lang-note break-keep" data-lang="ko">{note}</p>}
        {noteEnResolved && <p class="lang-note break-keep" data-lang="en">{noteEnResolved}</p>}
      </>
    )
  }
</div>

<style>
  .lang-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lang-proficiency {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(45, 45, 45, 0.6);
  }

  .lang-name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: #1d1d1f;
  }

  .lang-note {
    margin: 0.125rem 0 0;
    font-size: 0.7rem;
    color: rgba(45, 45, 45, 0.6);
  }
</style>
